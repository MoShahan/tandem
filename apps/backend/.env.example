PORT=3000
DATABASE_URL=postgresql://tandem:tandem@localhost:5432/tandem
# Local: leave unset (migrate/seed use DATABASE_URL). Render: Neon direct URL, no -pooler, sslmode=require.
# DIRECT_URL=
# Local only. Production boot refuses this value.
JWT_SECRET=change-me
# Access token. Local: 1d. Production (Render): set 15m. Refresh stays 7d.
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=true
LOG_LEVEL=info
